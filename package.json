{
  "name": "pos-system",
  "version": "1.0.0",
  "description": "POS Supermarket System",
  "scripts": {
    "dev:backend": "cd backend && npm run start",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm install && npm run build",
    "postinstall": "cd backend && npm install && npx prisma generate"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@netlify/functions": "^2.8.0",
    "serverless-http": "^3.2.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2"
  }
}
